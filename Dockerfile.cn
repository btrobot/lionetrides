# syntax=docker/dockerfile:1

# ============================================================
# Lionet Rides - 国内优化版 Dockerfile
# 支持镜像源配置，解决 Docker Hub 被墙问题
# ============================================================

# 构建参数：镜像源配置
ARG NODE_IMAGE=node:24-bookworm-slim
ARG NPM_REGISTRY=https://registry.npmmirror.com

# ============================================================
# Stage 1: 安装依赖
# ============================================================
FROM ${NODE_IMAGE} AS deps

WORKDIR /app

# 安装 pnpm（使用国内镜像）
RUN npm config set registry ${NPM_REGISTRY} && \
    npm install -g pnpm@latest

# 复制依赖文件
COPY package.json pnpm-lock.yaml ./

# 配置国内 npm 镜像源
RUN pnpm config set registry https://registry.npmmirror.com/

# 安装依赖（利用构建缓存）
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# ============================================================
# Stage 2: 构建应用
# ============================================================
FROM deps AS builder

WORKDIR /app

# 复制源码
COPY . .

# 构建 Next.js
RUN pnpm run build

# 打包迁移脚本
RUN pnpm tsup src/server.ts --format cjs --platform node --target node20 --outDir dist --no-splitting --no-minify

# ============================================================
# Stage 3: 生产运行
# ============================================================
FROM ${NODE_IMAGE} AS runner

# 时区设置
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# node 用户已在基础镜像中存在，直接使用

WORKDIR /app

# 安装 curl（健康检查）和 dumb-init（信号处理）
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl dumb-init && \
    rm -rf /var/lib/apt/lists/*

# 复制 standalone 产物
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

# 复制迁移工具
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/migrations ./migrations
COPY --from=builder --chown=node:node /app/drizzle ./drizzle

# 安装数据库迁移依赖
RUN npm install --no-save pg

# 复制入口脚本
COPY --chown=node:node docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 切换到非 root 用户
USER node

# 环境变量
ENV NODE_ENV=production
ENV PORT=5000
ENV HOSTNAME="0.0.0.0"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

EXPOSE 5000

ENTRYPOINT ["docker-entrypoint.sh"]
