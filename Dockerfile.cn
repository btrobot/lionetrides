# ============================================================
# Lionet Rides - 国内优化版 Dockerfile
# 使用国内镜像源，解决网络问题
# ============================================================

# ─── Stage 1: 安装依赖 ───
FROM node:24-bookworm-slim AS deps

# 配置 npm/pnpm 使用国内镜像源
RUN echo "registry=https://registry.npmmirror.com/" > /root/.npmrc && \
    corepack enable && \
    corepack prepare pnpm@latest --activate

WORKDIR /app

# 复制 package 文件
COPY package.json pnpm-lock.yaml ./

# 安装依赖
RUN pnpm install --frozen-lockfile --ignore-scripts --prod=false

# ─── Stage 2: 构建项目 ───
FROM node:24-bookworm-slim AS builder

RUN echo "registry=https://registry.npmmirror.com/" > /root/.npmrc && \
    corepack enable && \
    corepack prepare pnpm@latest --activate

WORKDIR /app

# 复制依赖
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# 设置环境变量
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# 构建 Next.js
RUN corepack enable && pnpm run build

# 导出 standalone 版本
RUN cp -r public .next/standalone/ && \
    cp -r .next/static .next/standalone/.next/

# ─── Stage 3: 生产镜像 ───
FROM node:24-bookworm-slim AS runner

WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=5000
ENV HOSTNAME="0.0.0.0"

# 安装 curl 用于健康检查
RUN apt-get update && apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# 复制 standalone 产物
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# 复制迁移相关文件
COPY --from=builder /app/drizzle ./drizzle
COPY --from=builder /app/migrations ./migrations

# 安装迁移工具（pg 用于执行 SQL）
RUN mkdir -p /app/migrations-tool && \
    cd /app/migrations-tool && \
    echo '{"name":"migrate","private":true}' > package.json && \
    echo "registry=https://registry.npmmirror.com/" > .npmrc && \
    npm install pg bcryptjs --save

# 复制迁移执行脚本
COPY --from=builder /app/migrate.js ./migrations/migrate.js

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# 启动命令
CMD ["node", "server.js"]
